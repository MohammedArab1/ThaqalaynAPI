# Local PostgreSQL from docker-compose.yml. Inside a container use host
# `postgres`. From the host (npm run dev) use port 5434:
# postgresql://thaqalayn:password@localhost:5434/thaqalayn
DATABASE_URL=postgresql://thaqalayn:password@postgres:5432/thaqalayn

# Credentials for the postgres service. Use an alphanumeric password:
# special characters must be percent-encoded inside DATABASE_URL.
POSTGRES_USER=thaqalayn
POSTGRES_PASSWORD=changeMe
POSTGRES_DB=thaqalayn
PORT=3001 #Used when starting the webapp locally
WEBAPP_URL=ThaqalaynWebAppAPIUrl #Used by the scraper to fetch from the Thaqalayn API
GEMINI_API_KEY=myApiKey
PLAUSIBLE_API_URL=https://plausible.example.com/api/event
PLAUSIBLE_DOMAIN=example.com

# Caching + rate limiting (requires REDIS_URL)
REDIS_URL=redis://localhost:6379

# Rate limiting (defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000

# Maximum time in ms to wait for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
