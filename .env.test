# Test environment. Loaded by dotenv-cli via the `npm test` script.
# Points at the throwaway Postgres from docker-compose.test.yml.
# NEVER point this at a production/Neon database: the suite will truncate tables.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/thaqalayn_test

# Keep Redis caching and external analytics out of the test process.
CACHE=false
PLAUSIBLE_API_URL=
PLAUSIBLE_DOMAIN=
