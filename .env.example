DATABASE_URL=postgresql://user:password@host:5432/database #Neon PostgreSQL connection string
PORT=3001 #Used when starting the webapp locally
WEBAPP_URL=ThaqalaynWebAppAPIUrl #Used by the scraper to fetch from the Thaqalayn API
GEMINI_API_KEY=myApiKey
PLAUSIBLE_API_URL=https://plausible.example.com/api/event
PLAUSIBLE_DOMAIN=example.com

# Caching + rate limiting (requires REDIS_URL)
REDIS_URL=redis://localhost:6379

# Rate limiting (defaults shown)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000

# Maximum time in ms to wait for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
